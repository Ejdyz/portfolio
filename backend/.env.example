# ==========================================
# Konfigurace backendu pro odesílání e-mailů
# ==========================================

# Port, na kterém backend server naslouchá (výchozí: 3001)
PORT=3001

# --- SMTP nastavení ---
# Adresa SMTP serveru (např. smtp.seznam.cz, smtp.gmail.com, mail.vasedomena.cz)
SMTP_HOST=smtp.seznam.cz

# Port SMTP serveru:
# - 465 pro SSL/TLS (výchozí)
# - 587 pro STARTTLS
# - 25 pro nešifrované spojení
SMTP_PORT=465

# Zabezpečené spojení (true / false):
# Pokud nezadáte, automaticky se nastaví na true pro port 465, jinak false
SMTP_SECURE=true

# Přihlašovací údaje k e-mailové schránce
EMAIL_USER=vas-email@seznam.cz
EMAIL_PASS=vase-heslo-nebo-heslo-aplikace

# --- Adresáti a odesílatelé ---
# Cílový e-mail, kam mají chodit zprávy z formuláře (výchozí: stejný jako EMAIL_USER)
EMAIL_TO=vas-email@seznam.cz

# Zobrazované jméno odesílatele v příchozím e-mailu (výchozí: hodnota SITE_NAME)
EMAIL_FROM="Jan Adam – Portfolio"

# Název webu/projektu pro předmět a hlavičky (výchozí: "Jan Adam – Portfolio")
SITE_NAME="Jan Adam – Portfolio"

# --- Zabezpečení formuláře ---
# Cloudflare Turnstile Secret Key (z Cloudflare Dashboardu)
TURNSTILE_SECRET=0x4AAAAAAA...

# --- Jazyk API ---
# Výchozí jazyk pro chybové a potvrzovací hlášky: cs | en (výchozí: cs)
# Poznámka: Jednotlivé formuláře mohou poslat také parametr 'lang' v požadavku.
API_LANG=cs

